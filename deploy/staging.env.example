# Salin menjadi deploy/staging.env lalu isi. Berkas staging.env tidak pernah masuk git.

# Image hasil CI yang akan dijalankan, sebaiknya dengan digest, mis.
# registry.contoh/tyio-app@sha256:...
TYIO_IMAGE=

# Kata sandi database. Pakai heksadesimal agar aman di dalam URL:  openssl rand -hex 24
TYIO_DB_PASSWORD=

# Alamat dan port aplikasi di server (bawaan 127.0.0.1:8080).
TYIO_APP_BIND=127.0.0.1
TYIO_APP_PORT=8080
