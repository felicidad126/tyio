# Salin menjadi deploy/staging.env lalu isi. Berkas staging.env tidak pernah masuk git.

# Image hasil CI yang akan dijalankan, sebaiknya dengan digest, mis.
# registry.contoh/tyio-app@sha256:...
TYIO_IMAGE=

# Kata sandi database. Pakai heksadesimal agar aman di dalam URL:  openssl rand -hex 24
TYIO_DB_PASSWORD=

# Alamat dan port aplikasi di server (bawaan 127.0.0.1:8080).
TYIO_APP_BIND=127.0.0.1
TYIO_APP_PORT=8080

# Cookie sesi hanya lewat HTTPS. Selama staging belum punya TLS (R-I) dan dibuka lewat
# http://<alamat-server> dari mesin lain, isi false; login tidak bisa tanpa ini.
# Kembalikan ke true begitu TLS terpasang. Akses lewat http://localhost tidak perlu diubah.
TYIO_SESSION_COOKIE_SECURE=true

# Isi 1 bila ada satu reverse proxy (penutup TLS) di depan aplikasi, agar IP klien untuk
# pembatasan login dan HTTPS terbaca benar. Kosongkan bila aplikasi diakses langsung.
TYIO_TRUST_PROXY=
