# Salin menjadi deploy/staging.env lalu isi. Berkas staging.env tidak pernah masuk git.
# Cara yang disarankan: `deploy/scripts/server.sh pasang <domain>` membuat berkas ini sendiri
# (lihat docs/operasi/server-demo.md). Isian di bawah untuk pemasangan manual.

# Alamat portal untuk HTTPS (deploy/compose.https.yml): domain, atau alamat IP server.
TYIO_DOMAIN=
# acme = sertifikat Let's Encrypt otomatis; internal = CA milik Caddy (IP/jaringan tertutup);
# panel = tanpa Caddy, domain dan SSL diurus panel server (aaPanel/Nginx) yang meneruskan ke
# 127.0.0.1:TYIO_APP_PORT, dengan TYIO_TRUST_PROXY_HOPS=1.
TYIO_TLS_MODE=acme

# Repo image di registry (diikuti server.sh perbarui lewat tag `demo`).
TYIO_IMAGE_REPO=ghcr.io/felicidad126/tyio

# Kata sandi akun contoh saat seed (minimal 12 karakter).
TYIO_SEED_PASSWORD=

# Image hasil CI yang akan dijalankan, sebaiknya dengan digest, mis.
# registry.contoh/tyio-app@sha256:...
TYIO_IMAGE=

# Kata sandi database. Pakai heksadesimal agar aman di dalam URL:  openssl rand -hex 24
TYIO_DB_PASSWORD=

# Alamat dan port aplikasi di server (bawaan 127.0.0.1:8080).
TYIO_APP_BIND=127.0.0.1
TYIO_APP_PORT=8080

# Cookie sesi hanya lewat HTTPS (bawaan true). false hanya sementara, di jaringan tertutup
# tanpa TLS; jangan di produksi.
TYIO_SESSION_COOKIE_SECURE=true

# Sumber gambar peta remote (opsional). Kosong = OpenStreetMap (gratis, untuk pemakaian ringan,
# atribusi wajib). Untuk pemakaian besar, isi URL penyedia berlangganan dengan {z}/{x}/{y}.
TYIO_MAP_TILE_URL=
TYIO_MAP_TILE_ATTRIBUTION=

# Jumlah reverse proxy (mis. nginx/HAProxy dengan TLS) di depan aplikasi. 0 bila tidak ada.
# Dengan deploy/compose.https.yml nilai ini diabaikan: Caddy satu-satunya proxy (1).
TYIO_TRUST_PROXY_HOPS=0
# Notifikasi Telegram (opsional). Token bot dari @BotFather; paling mudah diisi lewat
# `deploy/scripts/server.sh telegram` (token ditanyakan tanpa tampil dan diperiksa ke Telegram).
TYIO_TELEGRAM_BOT_TOKEN=
# Alamat portal untuk tautan di pesan notifikasi, mis. https://noc-demo.contoh.co.id.
# server.sh mengisinya sendiri dari TYIO_DOMAIN bila kosong.
TYIO_PUBLIC_URL=
