# Salin menjadi deploy/prod.env lalu isi (chmod 600). Berkas prod.env tidak pernah masuk git.
# Panduan: docs/operasi/produksi.md.

# Kata sandi database. Pakai heksadesimal agar aman di dalam URL:  openssl rand -hex 24
NPR_DB_PASSWORD=

# Nama host atau IP yang diketik pengguna di peramban, tanpa https://, mis. noc.perusahaan.co.id
NPR_HOST=

# Sumber sertifikat HTTPS (pilih satu, lihat deploy/Caddyfile):
#   internal                                  CA milik Caddy; tiap perangkat memasang root CA-nya
#   admin@perusahaan.co.id                    Let's Encrypt; DNS publik ke server, port 80/443 terbuka
#   "/certs/cert.pem /certs/key.pem"          berkas dari CA kantor, taruh di deploy/certs/
NPR_TLS=internal

# Folder berkas sertifikat di server (hanya untuk pilihan berkas di atas).
NPR_CERT_DIR=./certs

# Port HTTP dan HTTPS di server (bawaan 80 dan 443).
NPR_HTTP_PORT=80
NPR_HTTPS_PORT=443

# Backup terenkripsi harian (docs/operasi/backup.md). Wajib: berkas kunci PUBLIK backup.
# Kunci privatnya TIDAK disimpan di server ini.
NPR_BACKUP_PUBLIC_KEY=./kunci/backup-public.asc
# Folder backup di server (bawaan deploy/backup). Salin isinya ke lokasi kedua (lihat dokumen).
NPR_BACKUP_DIR=./backup
# Jam backup harian dalam UTC (18:30 UTC = 01:30 WIB) dan lama penyimpanan dalam hari.
NPR_BACKUP_TIME_UTC=18:30
NPR_BACKUP_RETENTION_DAYS=30
