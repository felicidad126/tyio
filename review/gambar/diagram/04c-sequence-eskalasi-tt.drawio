ometry x="655" y="38" width="150" height="48" as="geometry"/></mxCell><mxCell id="D" value="Database" style="fontFamily=Arial;fontColor=#1B1F24;shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#E3EAF5;strokeColor=#2B4C7E;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="34" width="120" height="60" as="geometry"/></mxCell><mxCell id="m1_172" value="1. Di detail NPR pilih Eskalasi Service,&#10;isi instruksi, catatan NOC, waktu,&#10;lalu klik Kirim TT" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="172" as="sourcePoint"/><mxPoint x="380" y="172" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m2_240" value='2. POST /api/nprs/:id/actions&#10;{kind: "Eskalasi Service", instruction, notes,&#10;remote_status, pending_by, occurred_at}' style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="240" as="sourcePoint"/><mxPoint x="730" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m3_306" value="3. 403 Asal permintaan tidak diizinkan" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="306" as="sourcePoint"/><mxPoint x="380" y="306" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m4_356" value="4. Cek sesi" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="356" as="sourcePoint"/><mxPoint x="1080" y="356" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m5_422" value="5. 401 Silakan login terlebih dahulu" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="422" as="sourcePoint"/><mxPoint x="380" y="422" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m6_472" value="6. SELECT nprs WHERE id" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="472" as="sourcePoint"/><mxPoint x="1080" y="472" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m7_538" value="7. Pesan galat" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="538" as="sourcePoint"/><mxPoint x="380" y="538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m8_588" value="8. SELECT waktu tindakan terakhir" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="588" as="sourcePoint"/><mxPoint x="1080" y="588" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m9_654" value="9. 400 Waktu tindakan tidak valid" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="654" as="sourcePoint"/><mxPoint x="380" y="654" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m10_704" value="10. SELECT tickets WHERE npr_id" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="704" as="sourcePoint"/><mxPoint x="1080" y="704" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m11_770" value="11. 409 NPR ini sudah memiliki TT" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="770" as="sourcePoint"/><mxPoint x="380" y="770" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m12_866" value="12. Naikkan penghitung_nomor&#10;(TT, bulan WIB)" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="866" as="sourcePoint"/><mxPoint x="1080" y="866" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m13_918" value="13. INSERT tickets, nomor TT&#10;dari penghitung, RETURNING number" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="918" as="sourcePoint"/><mxPoint x="1080" y="918" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m14_970" value='14. INSERT actions "Eskalasi Service"&#10;(hanya bila NPR belum CLOSED)' style="fontFamily=Aria