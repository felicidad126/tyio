 as="geometry"><mxPoint x="730" y="522" as="sourcePoint"/><mxPoint x="380" y="522" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m10_618" value="10. 400 Isi username dan password&#10;dengan benar" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="618" as="sourcePoint"/><mxPoint x="380" y="618" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m11_714" value="11. DELETE sessions dan login_attempts&#10;yang kedaluwarsa" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="714" as="sourcePoint"/><mxPoint x="1080" y="714" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m12_780" value="12. Tambah hitungan login_attempts&#10;untuk IP ini" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="780" as="sourcePoint"/><mxPoint x="1080" y="780" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m13_816" value="13. Jumlah percobaan" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="816" as="sourcePoint"/><mxPoint x="730" y="816" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m14_882" value="14. 429 Terlalu banyak percobaan login" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="882" as="sourcePoint"/><mxPoint x="380" y="882" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m15_948" value="15. SELECT users WHERE username&#10;(huruf kecil)" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="948" as="sourcePoint"/><mxPoint x="1080" y="948" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m16_984" value="16. Data akun, atau kosong" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="984" as="sourcePoint"/><mxPoint x="730" y="984" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n1020" value="Hitung hash PBKDF2 (100.000 putaran),&#10;tetap dihitung walau akun tidak ada" style="fontFamily=Arial;fontColor=#1B1F24;shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#C9A227;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="590.0" y="1010" width="280" height="46" as="geometry"/></mxCell><mxCell id="m17_1126" value="17. 401 Username atau password salah" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;strokeColor=#3B4656;fontSize=12;labelBackgroundColor=none;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="1126" as="sourcePoint"/><mxPoint x="380" y="1126" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m18_1206" value="18. 403 Akun ini sudah dinonaktifkan" style="fontFamily=Arial;fontColor=#1B1F24;html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;s