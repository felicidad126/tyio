{
  "name": "npr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "setup": "node scripts/setup.mjs",
    "setup:remote": "node scripts/setup.mjs --remote",
    "password:local": "node scripts/setup.mjs --reset-password",
    "password:remote": "node scripts/setup.mjs --remote --reset-password",
    "test:api": "node scripts/test-api.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node dist/server/main.js",
    "setup:server": "node dist/server/setup.js"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "wrangler": "^4.168.0"
  }
}
