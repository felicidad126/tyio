{
  "name": "tyio",
  "version": "0.0.0",
  "private": true,
  "description": "Portal NOC terpusat — monorepo (API, web, tipe bersama)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @tyio/api test",
    "e2e": "pnpm --filter @tyio/web e2e",
    "dev:up": "docker compose -f deploy/compose.dev.yml up -d --build --wait",
    "dev:down": "docker compose -f deploy/compose.dev.yml down",
    "dev:reset": "docker compose -f deploy/compose.dev.yml down --volumes"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vue-eslint-parser": "10.4.2"
  }
}
